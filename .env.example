# OASIS development environment template.
# Names only — never commit real values. The supported place for provider keys is
# OASIS -> Providers, which stores them in the OS-encrypted vault.
# These variables are honoured only when no key is saved in the vault.

# fal.ai (primary provider: image, video, background removal, speech)
FAL_API_KEY=

# DeepSeek (optional: prompt enhancement / reasoning text)
DEEPSEEK_API_KEY=

# Optional binary overrides (defaults: ffmpeg / ffprobe on PATH)
OASIS_FFMPEG=
OASIS_FFPROBE=
