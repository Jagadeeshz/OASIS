{
 "openapi": "3.1.0",
 "info": {
  "title": "Queue OpenAPI for fal-ai/flux/dev/image-to-image",
  "version": "1.0.0",
  "description": "The OpenAPI schema for the fal-ai/flux/dev/image-to-image queue.",
  "x-fal-metadata": {
   "endpointId": "fal-ai/flux/dev/image-to-image",
   "category": "image-to-image",
   "thumbnailUrl": "https://v3b.fal.media/files/b/0a9f91a9/up8aXYeFDjcRbQZDxV7vK_Jo37PJhg.png",
   "playgroundUrl": "https://fal.ai/models/fal-ai/flux/dev/image-to-image",
   "documentationUrl": "https://fal.ai/models/fal-ai/flux/dev/image-to-image/api",
   "about": "Image to image version of FLUX.1 [dev], next generation image-to-image model."
  }
 },
 "components": {
  "securitySchemes": {
   "apiKeyAuth": {
    "type": "apiKey",
    "in": "header",
    "name": "Authorization",
    "description": "Fal Key"
   }
  },
  "schemas": {
   "QueueStatus": {
    "type": "object",
    "properties": {
     "status": {
      "type": "string",
      "enum": [
       "IN_QUEUE",
       "IN_PROGRESS",
       "COMPLETED"
      ]
     },
     "request_id": {
      "type": "string",
      "description": "The request id."
     },
     "response_url": {
      "type": "string",
      "description": "The response url."
     },
     "status_url": {
      "type": "string",
      "description": "The status url."
     },
     "cancel_url": {
      "type": "string",
      "description": "The cancel url."
     },
     "logs": {
      "type": "object",
      "description": "The logs.",
      "additionalProperties": true
     },
     "metrics": {
      "type": "object",
      "description": "The metrics.",
      "additionalProperties": true
     },
     "queue_position": {
      "type": "integer",
      "description": "The queue position."
     }
    },
    "required": [
     "status",
     "request_id"
    ]
   },
   "FluxDevImageToImageInput": {
    "properties": {
     "image_url": {
      "description": "The URL of the image to generate an image from.",
      "title": "Image URL",
      "type": "string",
      "examples": [
       "https://fal.media/files/koala/Chls9L2ZnvuipUTEwlnJC.png"
      ]
     },
     "output_format": {
      "default": "jpeg",
      "description": "The format of the generated image.",
      "title": "Output Format",
      "enum": [
       "jpeg",
       "png"
      ],
      "type": "string"
     },
     "enable_safety_checker": {
      "description": "If set to true, the safety checker will be enabled. Disabling it requires account authorization; unauthorized requests are always checked, and images flagged as unsafe are returned as black images.",
      "default": true,
      "title": "Enable Safety Checker",
      "type": "boolean"
     },
     "sync_mode": {
      "description": "If `True`, the media will be returned as a data URI and the output data won't be available in the request history.",
      "default": false,
      "title": "Sync Mode",
      "type": "boolean"
     },
     "seed": {
      "description": "\n        The same seed and the same prompt given to the same version of the model\n        will output the same image every time.\n    ",
      "title": "Seed",
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ]
     },
     "acceleration": {
      "default": "none",
      "description": "The speed of the generation. The higher the speed, the faster the generation.",
      "title": "Acceleration",
      "enum": [
       "none",
       "regular",
       "high"
      ],
      "type": "string"
     },
     "num_inference_steps": {
      "description": "The number of inference steps to perform.",
      "default": 40,
      "title": "Num Inference Steps",
      "maximum": 50,
      "type": "integer",
      "minimum": 10
     },
     "prompt": {
      "description": "The prompt to generate an image from.",
      "title": "Prompt",
      "type": "string",
      "examples": [
       "A cat dressed as a wizard with a background of a mystic forest."
      ]
     },
     "num_images": {
      "description": "The number of images to generate.",
      "default": 1,
      "title": "Num Images",
      "maximum": 4,
      "type": "integer",
      "minimum": 1
     },
     "guidance_scale": {
      "description": "\n        The CFG (Classifier Free Guidance) scale is a measure of how close you want\n        the model to stick to your prompt when looking for a related image to show you.\n    ",
      "default": 3.5,
      "title": "Guidance scale (CFG)",
      "maximum": 20,
      "type": "number",
      "minimum": 1
     },
     "strength": {
      "description": "The strength of the initial image. Higher strength values are better for this model.",
      "default": 0.95,
      "title": "Strength",
      "maximum": 1,
      "type": "number",
      "minimum": 0.01
     }
    },
    "title": "BaseImageToInput",
    "x-fal-order-properties": [
     "image_url",
     "strength",
     "num_inference_steps",
     "prompt",
     "seed",
     "guidance_scale",
     "sync_mode",
     "num_images",
     "enable_safety_checker",
     "output_format",
     "acceleration"
    ],
    "required": [
     "image_url",
     "prompt"
    ],
    "type": "object"
   },
   "FluxDevImageToImageOutput": {
    "properties": {
     "timings": {
      "additionalProperties": {
       "type": "number"
      },
      "title": "Timings",
      "type": "object"
     },
     "has_nsfw_concepts": {
      "description": "Whether the generated images contain NSFW concepts.",
      "items": {
       "type": "boolean"
      },
      "title": "Has Nsfw Concepts",
      "type": "array"
     },
     "prompt": {
      "description": "The prompt used for generating the image.",
      "title": "Prompt",
      "type": "string"
     },
     "seed": {
      "description": "\n            Seed of the generated Image. It will be the same value of the one passed in the\n            input or the randomly generated that was used in case none was passed.\n        ",
      "title": "Seed",
      "type": "integer"
     },
     "images": {
      "description": "The generated image files info.",
      "items": {
       "$ref": "#/components/schemas/Image"
      },
      "title": "Images",
      "type": "array"
     }
    },
    "title": "Output",
    "x-fal-order-properties": [
     "images",
     "timings",
     "seed",
     "has_nsfw_concepts",
     "prompt"
    ],
    "required": [
     "images",
     "timings",
     "seed",
     "has_nsfw_concepts",
     "prompt"
    ],
    "type": "object"
   },
   "Image": {
    "properties": {
     "url": {
      "title": "Url",
      "type": "string"
     },
     "width": {
      "title": "Width",
      "type": "integer"
     },
     "height": {
      "title": "Height",
      "type": "integer"
     },
     "content_type": {
      "default": "image/jpeg",
      "title": "Content Type",
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     }
    },
    "title": "Image",
    "x-fal-order-properties": [
     "url",
     "width",
     "height",
     "content_type"
    ],
    "required": [
     "url",
     "width",
     "height"
    ],
    "type": "object"
   }
  }
 },
 "paths": {
  "/fal-ai/flux/dev/image-to-image/requests/{request_id}/status": {
   "get": {
    "parameters": [
     {
      "name": "request_id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "description": "Request ID"
      }
     },
     {
      "name": "logs",
      "in": "query",
      "required": false,
      "schema": {
       "type": "number",
       "description": "Whether to include logs (`1`) in the response or not (`0`)."
      }
     }
    ],
    "responses": {
     "200": {
      "description": "The request status.",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/QueueStatus"
        }
       }
      }
     }
    }
   }
  },
  "/fal-ai/flux/dev/image-to-image/requests/{request_id}/cancel": {
   "put": {
    "parameters": [
     {
      "name": "request_id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "description": "Request ID"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "The request was cancelled.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "success": {
           "type": "boolean",
           "description": "Whether the request was cancelled successfully."
          }
         }
        }
       }
      }
     }
    }
   }
  },
  "/fal-ai/flux/dev/image-to-image": {
   "post": {
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/FluxDevImageToImageInput"
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "The request status.",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/QueueStatus"
        }
       }
      }
     }
    }
   }
  },
  "/fal-ai/flux/dev/image-to-image/requests/{request_id}": {
   "get": {
    "parameters": [
     {
      "name": "request_id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "description": "Request ID"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Result of the request.",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/FluxDevImageToImageOutput"
        }
       }
      }
     }
    }
   }
  }
 },
 "servers": [
  {
   "url": "https://queue.fal.run"
  }
 ],
 "security": [
  {
   "apiKeyAuth": []
  }
 ]
}